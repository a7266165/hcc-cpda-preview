    {"name": "tumor_number", "section": "tumour", "kind": "choice", "options": [0, 1]},
    {"name": "lymphonodules", "section": "tumour", "kind": "choice", "options": [0, 1]},
    {"name": "metastatsis", "section": "tumour", "kind": "choice", "options": [0, 1]},
